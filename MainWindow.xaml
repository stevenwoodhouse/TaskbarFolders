<Window x:Class="TaskbarFolders.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Taskbar Folders"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="False"
        ShowActivated="False"
        SizeToContent="Manual"
        Height="48"
        Width="200">
  <Border x:Name="RootBorder"
          Background="Transparent"
          BorderThickness="0"
          MouseRightButtonUp="RootBorder_MouseRightButtonUp">
    <Grid x:Name="RootGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="LeftGripColumn" Width="6"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition x:Name="RightGripColumn" Width="0"/>
      </Grid.ColumnDefinitions>

      <Border x:Name="LeftGrip"
              Grid.Column="0"
              Background="#33FFFFFF"
              Cursor="SizeWE"
              ToolTip="Drag to resize"
              MouseLeftButtonDown="Grip_MouseLeftButtonDown"
              MouseMove="Grip_MouseMove"
              MouseLeftButtonUp="Grip_MouseLeftButtonUp"
              LostMouseCapture="Grip_LostMouseCapture">
        <Canvas HorizontalAlignment="Center" VerticalAlignment="Center" Width="3" Height="14" IsHitTestVisible="False">
          <Ellipse Width="2" Height="2" Fill="#99FFFFFF" Canvas.Top="0" Canvas.Left="0.5"/>
          <Ellipse Width="2" Height="2" Fill="#99FFFFFF" Canvas.Top="4" Canvas.Left="0.5"/>
          <Ellipse Width="2" Height="2" Fill="#99FFFFFF" Canvas.Top="8" Canvas.Left="0.5"/>
          <Ellipse Width="2" Height="2" Fill="#99FFFFFF" Canvas.Top="12" Canvas.Left="0.5"/>
        </Canvas>
      </Border>

      <ScrollViewer Grid.Column="1"
                    HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollBarVisibility="Disabled"
                    CanContentScroll="False">
        <StackPanel x:Name="FolderButtons"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"/>
      </ScrollViewer>

      <Border x:Name="RightGrip"
              Grid.Column="2"
              Background="#33FFFFFF"
              Cursor="SizeWE"
              ToolTip="Drag to resize"
              MouseLeftButtonDown="Grip_MouseLeftButtonDown"
              MouseMove="Grip_MouseMove"
              MouseLeftButtonUp="Grip_MouseLeftButtonUp"
              LostMouseCapture="Grip_LostMouseCapture">
        <Canvas HorizontalAlignment="Center" VerticalAlignment="Center" Width="3" Height="14" IsHitTestVisible="False">
          <Ellipse Width="2" Height="2" Fill="#99FFFFFF" Canvas.Top="0" Canvas.Left="0.5"/>
          <Ellipse Width="2" Height="2" Fill="#99FFFFFF" Canvas.Top="4" Canvas.Left="0.5"/>
          <Ellipse Width="2" Height="2" Fill="#99FFFFFF" Canvas.Top="8" Canvas.Left="0.5"/>
          <Ellipse Width="2" Height="2" Fill="#99FFFFFF" Canvas.Top="12" Canvas.Left="0.5"/>
        </Canvas>
      </Border>
    </Grid>
  </Border>
  <Window.ContextMenu>
    <ContextMenu>
      <MenuItem Header="Add folder…" Click="AddFolder_Click"/>
      <MenuItem Header="Settings…" Click="Settings_Click"/>
      <MenuItem Header="Reset width to fit" Click="ResetWidth_Click"/>
      <Separator/>
      <MenuItem Header="Hide toolbar" Click="HideToolbar_Click"/>
      <MenuItem Header="Exit" Click="Exit_Click"/>
    </ContextMenu>
  </Window.ContextMenu>
</Window>
